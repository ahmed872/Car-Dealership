{
  "name": "@autohub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -r @swc-node/register src/db/migrate.ts",
    "db:reset": "node -r @swc-node/register src/db/reset.ts",
    "db:seed:dev": "node -r @swc-node/register src/db/seed-dev.ts",
    "cli": "node -r @swc-node/register src/cli.ts",
    "test": "vitest run",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@autohub/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.908.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.44.7",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "nestjs-pino": "4.4.1",
    "nestjs-zod": "5.0.1",
    "pg": "8.16.3",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.5",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "4.1.12"
  }
}
