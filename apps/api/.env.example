# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Application role — RLS enforced (NOT superuser / BYPASSRLS / owner). See infra/db/bootstrap-roles.sql
DATABASE_URL=postgres://autohub_app:CHANGE_ME@localhost:5432/autohub
# Owner role — migrations only
DATABASE_MIGRATION_URL=postgres://autohub_owner:CHANGE_ME@localhost:5432/autohub
APP_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# CHROMIUM_PATH=/usr/bin/chromium
LOG_LEVEL=info
JOBS_ENABLED=true
# Optional integrations (disabled when empty)
# ANTHROPIC_API_KEY=
# VIN_DECODER=nhtsa
