# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=3000
# Application role — RLS enforced (NOT superuser / BYPASSRLS / owner). See infra/db/bootstrap-roles.sql
DATABASE_URL=postgres://autohub_app:CHANGE_ME@localhost:5432/autohub
# Owner role — migrations only
DATABASE_MIGRATION_URL=postgres://autohub_owner:CHANGE_ME@localhost:5432/autohub
APP_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# CHROMIUM_PATH=/usr/bin/chromium
# PDF renders at once / waiting (more waiting requests get 503 pdf_busy); report exports per client per minute
# PDF_MAX_CONCURRENT=2
# PDF_MAX_QUEUE=4
# EXPORT_RATE_LIMIT_PER_MIN=20
LOG_LEVEL=info
JOBS_ENABLED=true
# Optional integrations (disabled when empty)
# Optional platform-wide key for AI listing text; companies may instead store their own key
# (Settings → Integrations). AI is used only where a company enables it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI descriptions per company per day when the platform key above is used (company keys are not capped here).
AI_PLATFORM_DAILY_LIMIT=50
# Online showroom inquiries stored per company per 24 hours (more are acknowledged but not stored).
SHOWROOM_DAILY_INQUIRY_LIMIT=200
# DEVELOPMENT/TEST ONLY: allow company webhooks to reach http:// and private addresses. Refused in production.
OUTBOUND_ALLOW_PRIVATE_HOSTS=false
