{
  "name": "@autohub/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "AutoHub Pro desktop edition",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "stage": "node scripts/stage.mjs",
    "pack:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "smoke": "node test/smoke.mjs",
    "license": "node scripts/license.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "esbuild": "0.25.12",
    "pg": "8.16.3",
    "tar": "7.5.1",
    "typescript": "5.9.3"
  },
  "productName": "AutoHub Pro",
  "author": "AutoHub Pro",
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "16.14.0-beta.17"
  }
}
