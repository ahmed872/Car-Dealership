{
  "name": "autohub-pro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @autohub/shared test",
    "test:api": "pnpm --filter @autohub/api test",
    "test:e2e": "pnpm --filter @autohub/e2e test",
    "db:migrate": "pnpm --filter @autohub/api db:migrate",
    "db:seed:dev": "pnpm --filter @autohub/api db:seed:dev",
    "dev:api": "pnpm --filter @autohub/api dev",
    "dev:web": "pnpm --filter @autohub/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
